{
  "name": "draw-out-spike",
  "displayName": "Draw-out (spike)",
  "description": "PROTOTYPE, throwaway. T3 chat in a panel, and MCP tools that open and annotate files.",
  "version": "0.0.1",
  "publisher": "galer7",
  "private": true,
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "drawOut.openChat",
        "title": "Draw-out: Open T3 Chat"
      },
      {
        "command": "drawOut.reply",
        "title": "Send to T3",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "drawOut.prevStep",
        "title": "Previous step",
        "icon": "$(arrow-left)"
      },
      {
        "command": "drawOut.nextStep",
        "title": "Next step",
        "icon": "$(arrow-right)"
      },
      {
        "command": "drawOut.reloadChat",
        "title": "Draw-out: Reload T3 Chat"
      },
      {
        "command": "drawOut.showStep",
        "title": "Show step"
      }
    ],
    "menus": {
      "comments/commentThread/context": [
        {
          "command": "drawOut.reply",
          "group": "inline",
          "when": "commentController == draw-out"
        }
      ],
      "commandPalette": [
        {
          "command": "drawOut.reply",
          "when": "false"
        },
        {
          "command": "drawOut.prevStep",
          "when": "false"
        },
        {
          "command": "drawOut.nextStep",
          "when": "false"
        },
        {
          "command": "drawOut.showStep",
          "when": "false"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "drawOut.prevStep",
          "group": "navigation@1",
          "when": "commentController == draw-out && commentThread =~ /^drawout/ && !(commentThread =~ / first/)"
        },
        {
          "command": "drawOut.nextStep",
          "group": "navigation@2",
          "when": "commentController == draw-out && commentThread =~ /^drawout/ && !(commentThread =~ / last/)"
        }
      ]
    },
    "configuration": {
      "title": "Draw-out",
      "properties": {
        "drawOut.t3Url": {
          "type": "string",
          "default": "http://127.0.0.1:3780",
          "description": "T3 server that the chat panel shows and that comment replies go to."
        },
        "drawOut.t3BaseDir": {
          "type": "string",
          "default": "~/.t3-drawout",
          "description": "Data folder of that T3 server. The bridge file goes in its editor-bridges folder."
        },
        "drawOut.t3Cli": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "/Users/gabrielgaler/.local/share/mise/installs/node/24.13.1/bin/node",
            "/Users/gabrielgaler/p/_forks/t3code/apps/server/src/bin.ts"
          ],
          "description": "Command that runs that T3 server CLI. Default: the patched T3 in ~/p/_forks/t3code. Empty: the T3 Code (Alpha) app."
        },
        "drawOut.chatMode": {
          "type": "string",
          "enum": [
            "direct",
            "proxy",
            "proxy-samesite-none"
          ],
          "default": "proxy-samesite-none",
          "description": "direct: frame the T3 server. proxy: frame a logging proxy. proxy-samesite-none: the proxy also rewrites the session cookie to SameSite=None; Secure."
        },
        "drawOut.proxyPort": {
          "type": "number",
          "default": 0,
          "description": "0 picks a free port per window."
        },
        "drawOut.mcpPort": {
          "type": "number",
          "default": 0,
          "description": "0 picks a free port per window. A patched T3 finds it through the bridge file."
        }
      }
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "drawOut",
          "title": "Draw-out",
          "icon": "media/draw-out.svg"
        }
      ]
    },
    "views": {
      "drawOut": [
        {
          "type": "webview",
          "id": "drawOut.chat",
          "name": "T3"
        }
      ],
      "explorer": [
        {
          "id": "drawOut.trace",
          "name": "Draw-out Trace"
        }
      ]
    }
  }
}
